# Streamlit Community Cloud Secrets Example
# Copy this into the "Secrets" settings in your Streamlit Cloud Dashboard

# LLM API Key (OpenRouter OpenAI-compatible API)
OPENROUTER_API_KEY = "your-openrouter-api-key-here"
LLM_MODEL = "nvidia/nemotron-3.5-lightning:free"

# AWS Cloud Settings (optional, if running cloud tools from UI)
AWS_REGION = "us-east-1"
S3_VERSIONS_PREFIX = "gluehealer-versions"
